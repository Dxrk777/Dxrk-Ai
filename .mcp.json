      "args": ["-y", "@notionhq/notion-mcp-server"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "mcp-server-memory"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "supabase-mcp"]
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp"]
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-mcp-server"]
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "linear-mcp-server"]
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "obsidian-mcp-server"]
