# Ignore Git metadata
.git
.gitignore

# Ignore editor/IDE artifacts
.idea
.vscode
*.swp
*.swo
*~

# Ignore macOS artifacts
.DS_Store

# Ignore Go build cache (rebuilt inside container)
bin/

# Ignore large/unnecessary dirs
node_modules/
__pycache__/
vendor/
testdata/

# Ignore docs and config not needed in image
*.md
*.example
.env*
!.env.example
renovate.json
.gitignore

# Ignore agent/generated metadata
.atl/
.engram/
